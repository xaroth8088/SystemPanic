  "items": [
    {
      "request": "Three rotating pilots",
      "status": "implemented and verified",
      "result": "Original single-pose Orbit Keeper, Void Drifter and Iron Circuit assets restored byte-for-byte from their original source crops; sprite rotation restored. Movement/abilities and existing gameplay tuning retained."
    },
    {
      "request": "Facing clutter",
      "status": "implemented and verified",
      "result": "Shared facing ticks and redundant weapon aiming dots removed."
    },
    {
      "request": "Sky floor alignment",
      "status": "implemented and verified",
      "result": "Pilot and crawler physical bounds now meet HEIGHT=480; local crawler drawing aligns alpha feet. Both floor and platform contacts retain their proper body radii."
    },
    {
      "request": "Sky sword",
      "status": "implemented and verified",
      "result": "A mirrored 0.22s overhead sweep hits each enemy once and pushes surviving targets 28px through geometry with a 95px/s impulse. Throw/retrieve mechanics persist; dropped-sword arrow removed. The ordinary-input QA recovery route completes deck descents."
    },
    {
      "request": "Control prose",
      "status": "implemented and verified",
      "result": "Removed all in-arena control instruction prose at Pak draw sites. Resource meters/numeric nectar and menu/footer help remain."
    },
    {
      "request": "Orbit cover",
      "status": "implemented and verified",
      "result": "Obstacles return zero damage and remain indestructible."
    },
    {
      "request": "Neon paddle",
      "status": "implemented and verified",
      "result": "Existing sprite rendered as an 84x24 paddle, flush on all four edges. A Pak-owned rectangular contact footprint lets outer-span ball returns work. Original firing assistance retained; border reflections use perpendicular normals."
    },
    {
      "request": "Maze exits",
      "status": "implemented and verified",
      "result": "No forced clear center row. Seeded exit height and short east/west stubs join a connected braided maze; actual geometry drives route/wrap queries."
    },
    {
      "request": "Burrow enemies",
      "status": "implemented and verified",
      "result": "No attack cues or emergence windup; underground phase transitions immediately to the committed rush."
    },
    {
      "request": "Vector enemies",
      "status": "implemented and verified",
      "result": "Base contact damage 32 plus level scaling; drift, 0.25-0.45s pause, then a random-heading 0.4s dart at 3.8x speed."
    },
    {
      "request": "Star enemy fire",
      "status": "implemented and verified",
      "result": "Targets scatter within +/-95x28px of player; three spread shots, five from level eight. Formation interval reduced to 1.75s before scaling."
    },
    {
      "request": "Tide movement",
      "status": "implemented and verified",
      "result": "Normal/ferry hops grant no invulnerability. Pilot protection circle omitted; existing post-hit and arrival safety remain separate."
    },
    {
      "request": "Bloom damage/radius",
      "status": "implemented and verified",
      "result": "Damage is 8+112*growth**2.4; radius 28+70*growth, capped at 98. Cascade reach radius+20. Nectar funding and capacity-only upgrades remain."
    }
  ],
