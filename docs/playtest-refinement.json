    {
      "request": "Iron: heading, acceleration and speed-powered shots",
      "status": "implemented and verified",
      "behavior": "Wall contact retains heading. Automatic acceleration caps at 340 normally or 430 in overdrive. Resolved displacement determines momentum, excluding stationary wall pushing."
    },
    {
      "request": "Sky: stab, charged throw and physical sword recovery",
      "status": "implemented and verified",
      "behavior": "Tap stabs; charge at least .55s to throw the single powerful blade, then collect it before attacking again. Persistent ownership survives locked-weapon projectile cleanup, terrain and level changes safely."
    },
    {
      "request": "Phase: hidden attack radius",
      "status": "implemented and verified",
      "behavior": "No reach circle, numerical radius or range-miss cue; finite mechanical reach remains."
    },
    {
      "request": "Neon: continuous music loop",
      "status": "implemented and verified",
      "behavior": "Preserved generated WAV; [0,20.8] source region omits the fade, producing a 20.62s cyclic master. Full join/interior RMS floor 0.5989263436391524."
    },
    {
      "request": "Maze: generated maze and wrap tunnels",
      "status": "implemented and verified",
      "behavior": "Seeded connected 30x15 maze with braids and east/west tunnel. Pilot, enemies and lunge/knockbacks wrap locally. Cardinal routing recovers from displaced grid alignment without reversal stalls."
    },
    {
      "request": "Pilots: only useful facing art",
      "status": "implemented and verified",
      "behavior": "Sixteen selected original sheets: ten 8x4, five 4x4, Sky 2x4 upright run/jump. Star retains its forward ship; Orbit its symmetric spin. All 408 new pilot frames rendered at 44px; fixed scale/center registration and Sky foot baseline."
    },
    {
      "request": "Vector: close captures with earlier boundaries",
      "status": "implemented and verified",
      "behavior": "Anchored live paths close against a connected network of surviving old edges. Disconnected, expired or outline-only paths do not falsely capture."
    },
    {
      "request": "Star: immediate attacks",
      "status": "implemented and verified",
      "behavior": "Timer expiry shoots and starts its committed dive without a tell/marker state."
    },
    {
      "request": "Star: cellular bunkers",
      "status": "implemented and verified",
      "behavior": "Seeded arches consist of independent 16px, 18-health cells. Both player and hostile shots erode their actual first-contact cell."
    },
    {
      "request": "Tide: shared hop grid and richer canals",
      "status": "implemented and verified",
      "behavior": "Pilot/traffic use 24+48k centers, including 96px ferry hops and enemy pauses. External towing yields through public position changes. Seeded islands/quays, eddies, reeds, banks and lily pads stay role-local."
    }
